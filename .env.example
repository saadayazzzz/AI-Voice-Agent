# Copy this file to .env and fill in your credentials.

# ============================================================
#  REQUIRED — OpenAI key with Realtime API access
#  platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=

OPENAI_REALTIME_MODEL=gpt-realtime
# Voices: alloy | ash | ballad | coral | echo | sage | shimmer | verse | marin | cedar
# OpenAI recommends marin or cedar for best quality.
OPENAI_VOICE=marin

# ============================================================
#  AGENT PERSONALITY — edit freely, restart server to apply
# ============================================================
AGENT_SYSTEM_PROMPT=You are a friendly, concise voice assistant for a business called Acme Co. Greet the caller, understand why they are calling, answer questions helpfully, and if they want to leave contact details use the save_lead tool. Keep responses short and conversational since this is a spoken conversation.
AGENT_GREETING=Hi! Thanks for calling Acme Co. How can I help you today?

# ============================================================
#  OPTIONAL — Twilio, only for real phone calls.
#  Leave blank to run browser-only; the dashboard still works.
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Your ngrok/deployed HTTPS URL, no trailing slash (Twilio only)
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ============================================================
#  APP
# ============================================================
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./voice_agent.db
LOG_LEVEL=INFO
